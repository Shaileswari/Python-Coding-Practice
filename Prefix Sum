def sumRange(nums, left, right):
    # Create prefix array
    prefix = [0] * len(nums)
    # Store first element
    prefix[0] = nums[0]
    # Calculate prefix sum
    for i in range(1, len(nums)):
        prefix[i] = prefix[i-1] + nums[i]
    # Calculate range sum
    if left == 0:
        return prefix[right]
    return prefix[right] - prefix[left-1]
# Input
nums = [-2, 0, 3, -5, 2, -1]
# Queries
print(sumRange(nums, 0, 2))
print(sumRange(nums, 2, 5))
print(sumRange(nums, 0, 5))
